{
  "productName": "JVM Desktop",
  "version": "0.1.0",
  "identifier": "io.github.jvmdesktop.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build && cargo build --release -p jvm-cli && npm run copy:shim",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JVM Desktop",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"],
    "resources": ["jvm.exe"],
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
